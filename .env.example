# Copy to .env and adjust.

# Public hostname for HTTPS (docker compose / Caddy only). Without a domain, use
# your server's IP with dashes via sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=

# Everything below is optional.

# Port the Node server listens on (behind Caddy this stays internal).
# PORT=8080

# Require this code to create a game room. Strongly recommended on a public server
# so strangers can't use your instance.
# ACCESS_CODE=change-me

# Only allow rooms for these Twitch channels (comma-separated).
# ALLOWED_CHANNELS=your_channel

# Where rooms and scores are stored.
# DATA_DIR=./data

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Delete rooms nobody has used for this many days.
# ROOM_RETENTION_DAYS=30

# Upper bound on rooms held by this server.
# MAX_ROOMS=500

# Set to true when behind a reverse proxy (compose.yaml sets this for you).
# TRUST_PROXY=false
